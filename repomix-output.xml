          <Picker.Item label="מסמך (doc)" value="doc" />
          <Picker.Item label="PDF" value="pdf" />
          <Picker.Item label="תמונה (image)" value="image" />
          <Picker.Item label="וידאו (video)" value="video" />
          <Picker.Item label="שמע (audio)" value="audio" />
